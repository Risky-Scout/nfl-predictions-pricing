# Root of the private, git-ignored historical data estate (nflverse backfill
# parquets, timestamped Odds API history snapshot stores). See
# src/nfl_hybrid/data/external_data.py.
NFL_MODEL_DATA_ROOT=/path/to/your-nfl-data-estate

# Paid historical/current odds
THE_ODDS_API_KEY=

# Optional licensed injury automation
SPORTRADAR_API_KEY=

# User-provided Spreadspoke CSV path
SPREADSPOKE_CSV_PATH=/absolute/path/to/spreadspoke_scores.csv

# BALLDONTLIE NFL live-data provider (Fix 5). See
# docs/BDL_LIVE_INTEGRATION.md. Not required to run the offline test suite --
# only for real client calls / the optional live smoke test.
BALLDONTLIE_API_KEY=

# Root for immutable raw BDL provider snapshots (Fix 5). Distinct from
# NFL_MODEL_DATA_ROOT (the historical, licensed estate) and
# NFL_MODEL_ARTIFACT_ROOT (derived pipeline output) -- see
# src/nfl_hybrid/providers/balldontlie/raw_store.py.
NFL_LIVE_DATA_ROOT=/path/to/your-live-data-cache
